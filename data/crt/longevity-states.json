  {
    "id": "LOW_VO2MAX",
    "label": "Nízká aerobní kapacita",
    "label_layman": "Zadýchávám se při námaze",
    "type": "ude",
    "typical_level": 2,
    "can_be_root": false,
    "typical_branch": "RC",
    "med_targets": [],
    "typical_children": [],
    "panel_text": "VO2max je nejsilnější prediktor délky života — silnější než kouření, diabetes nebo kardiovaskulární choroby. Každé zvýšení o 1 MET snižuje riziko úmrtí o ~13 %. Aerobní kapacita se dá trénovat v každém věku."
  },
  {
    "id": "MUSCLE_WEAKNESS",
    "label": "Svalová slabost",
    "label_layman": "Nemohu zdvihnout co dřív",
    "type": "ude",
    "typical_level": 4,
    "can_be_root": false,
    "typical_branch": "R",
    "med_targets": [],
    "typical_children": [],
    "panel_text": "Svalová hmota je metabolicky aktivní tkáň — její ztráta (sarkopenie) urychluje metabolickou dysregulaci a zvyšuje riziko pádů a ztráty samostatnosti. Silový trénink je jediná intervence, která ji spolehlivě obnovuje."
  },
  {
    "id": "MOBILITY_DEFICIT",
    "label": "Omezená pohyblivost",
    "label_layman": "Tuhé klouby, omezený pohyb",
    "type": "ude",
    "typical_level": 3,
    "can_be_root": false,
    "typical_branch": "R",
    "med_targets": [],
    "typical_children": [],
    "panel_text": "Omezený rozsah pohybu v ramenou, kyčlích a páteři predikuje ztrátu funkční nezávislosti. Pohyblivost se ztrácí postupně a nenápadně — ale dá se zvrátit cílenou prací na kloubní mobilitě."
  },
  {
    "id": "PHYSICAL_DECONDITIONING",
    "label": "Nízká fyzická kondice",
    "label_layman": "Slabá fyzička",
    "type": "cause",
    "typical_level": 1,
    "can_be_root": false,
    "typical_branch": "R",
    "med_targets": [],
    "typical_children": [
      "FATIGUE_LOW_CAPACITY"
    ],
    "panel_text": "VO2max a svalová síla jsou nejsilnějšími prediktory délky a kvality života — silnějšími než kouření nebo diabetes. Po 35. roce ztrácíme bez intervence 1 % aerobní kapacity ročně. Nízká kondice zvyšuje zátěž srdce při každé námaze a urychluje metabolickou dysregulaci — je to obousměrný vztah."
  },
  {
    "id": "INACTIVITY_ROOT",
    "label": "Pohybová inaktivita",
    "label_layman": "Sedavý životní styl",
    "type": "cause",
    "typical_level": 0,
    "can_be_root": true,
    "typical_branch": "L",
    "med_targets": [],
    "typical_children": [
      "PHYSICAL_DECONDITIONING"
    ],
    "panel_text": "Pohybová inaktivita je přímou příčinou ztráty aerobní kapacity, svalové síly a rozsahu pohybu. Bez pohybového stimulu tělo ztrácí funkční kapacitu od 35. roku. Tento proces je plně reverzibilní — i mírný pravidelný pohyb ho zastaví a zvrátí."
  },
  {
    "id": "SEDENTARY_LIFESTYLE_ROOT",
    "label": "Sedentismus",
    "label_layman": "Sedavý způsob života",
    "type": "cause",
    "typical_level": 0,
    "can_be_root": true,
    "typical_branch": "C",
    "med_targets": [],
    "typical_children": [
      "DYSLIPIDEMIA",
      "HYPERURICEMIA",
      "OBESITY",
      "BONE_DENSITY_LOSS"
    ],
    "panel_text": "Sedentismus je systémový stav — ne jen málo pohybu, ale chronická absence pohybového stimulu. 8+ hodin sezení denně aktivuje prozánětlivé dráhy, zvyšuje LDL, kyselinu močovou a inzulínovou rezistenci nezávisle na dietě. Každá hodina navíc zvyšuje KV riziko o ~2 %. Přestávky na pohyb každých 90 minut tyto markery měřitelně snižují do 4 týdnů — bez jiné intervence."
  },
  {
    "id": "THREATENED_HEALTHSPAN",
    "label": "Riziko mrtvice/infarktu",
    "label_layman": "Riziko mrtvice/infarktu",
    "type": "ude",
    "typical_level": 5,
    "can_be_root": false,
    "typical_branch": "C",
    "med_targets": [
      "pradaxa",
      "dabigatran",
      "nolpaza",
      "pantoprazol",
      "pantoprazole"
    ],
    "typical_children": [],
    "panel_text": "Fibrilace síní a erektilní dysfunkce jsou viditelné projevy systémové cévní a metabolické dysregulace. Bez intervence tento stav vede ke ztrátě fyzické výkonnosti, kognitivní kapacity a nakonec i funkční nezávislosti — přesně toho, co Dekatlon chrání. Toto je tvůj skutečný protivník."
  }
]