{
  "domain": "Biovesmir_Kardio_V1",
  "version": "1.0.0",
  "description": "Znalostní báze: kardiovaskulární, autonomní a elektrický subsystém",

  "nodes": [
    { "id": "N_ROOT",        "label": "Sedavý životní styl",         "layer": 0, "branch": "center", "type": "root" },
    { "id": "N_STRES",       "label": "Chronický stres",             "layer": 1, "branch": "right" },
    { "id": "N_LDL",         "label": "Vysoké LDL v krvi",           "layer": 1, "branch": "left" },
    { "id": "N_INSRES",      "label": "Inzulínová rezistence",       "layer": 1, "branch": "left" },
    { "id": "N_DEKONDICE",   "label": "Slabá fyzická kondice",       "layer": 1, "branch": "center" },
    { "id": "N_SPANEK",      "label": "Spánkový deficit",            "layer": 1, "branch": "right" },
    { "id": "N_SYMPATIKUS",  "label": "Aktivace sympatiku",          "layer": 2, "branch": "right" },
    { "id": "N_PLAKY",       "label": "Usazeniny v cévách",          "layer": 2, "branch": "left" },
    { "id": "N_ZATEZ",       "label": "Vyšší zátěž srdce",           "layer": 2, "branch": "center" },
    { "id": "N_ZANET",       "label": "Zánět cév",                   "layer": 3, "branch": "left" },
    { "id": "N_HYPOKALEMIE", "label": "Nízký draslík",              "layer": 2, "branch": "right" },
    { "id": "N_ZTUHE_CEVY",  "label": "Ztuhlé cévy",                "layer": 4, "branch": "left" },
    { "id": "N_NAPETI_ANS",  "label": "Napětí nervového systému",   "layer": 3, "branch": "right" },
    { "id": "N_NIZKE_HRV",   "label": "Nízká HRV",                  "layer": 3, "branch": "right" },
    { "id": "N_VYSOKY_TK",   "label": "Vysoký krevní tlak",         "layer": 5, "branch": "left" },
    { "id": "N_DRAZDIVOST",  "label": "Elektrická dráždivost síní", "layer": 5, "branch": "right" },
    { "id": "N_MECH_TLAK",   "label": "Mechanický tlak na srdce",   "layer": 6, "branch": "left" },
    { "id": "N_EXTRASYSTOLY","label": "Extrasystoly",               "layer": 7, "branch": "center", "type": "junction" },
    { "id": "N_FAP",         "label": "Fibrilace síní (FaP)",       "layer": 8, "branch": "center", "type": "ude" }
  ],

  "possible_arrows": [
    { "id": "A_001", "from": "N_ROOT",       "to": "N_LDL",          "condition": "user.labs.ldl > 3.0" },
    { "id": "A_002", "from": "N_ROOT",       "to": "N_INSRES",       "condition": "user.labs.glucose > 5.6 || user.labs.hba1c > 5.7" },
    { "id": "A_003", "from": "N_ROOT",       "to": "N_DEKONDICE",    "condition": "user.checkin.movement_level == 'low'" },
    { "id": "A_004", "from": "N_ROOT",       "to": "N_STRES",        "condition": "user.checkin.stress > 3 || user.diagnoses.includes('CHRONICKY_STRES')" },
    { "id": "A_005", "from": "N_ROOT",       "to": "N_SPANEK",       "condition": "user.checkin.sleep_hours < 6.5" },

    { "id": "A_006", "from": "N_LDL",        "to": "N_PLAKY",        "condition": "user.labs.ldl > 3.0" },
    { "id": "A_007", "from": "N_INSRES",     "to": "N_LDL",          "condition": "user.labs.glucose > 5.6 && user.labs.ldl > 3.0" },
    { "id": "A_008", "from": "N_INSRES",     "to": "N_ZANET",        "condition": "user.labs.glucose > 6.0 || user.labs.hba1c > 6.0" },
    { "id": "A_009", "from": "N_PLAKY",      "to": "N_ZANET",        "condition": "user.labs.crp > 1.0" },
    { "id": "A_010", "from": "N_PLAKY",      "to": "N_ZTUHE_CEVY",   "condition": "user.labs.ldl > 4.0 || user.diagnoses.includes('ATEROSKLEROZA')" },
    { "id": "A_011", "from": "N_ZANET",      "to": "N_ZTUHE_CEVY",   "condition": "user.labs.crp > 1.0 && user.labs.ldl > 3.0" },
    { "id": "A_012", "from": "N_ZTUHE_CEVY", "to": "N_VYSOKY_TK",   "condition": "user.labs.systolic_bp > 130 || user.diagnoses.includes('HYPERTENZE')" },
    { "id": "A_013", "from": "N_VYSOKY_TK",  "to": "N_MECH_TLAK",   "condition": "user.labs.systolic_bp > 140 || user.diagnoses.includes('HYPERTENZE')" },
    { "id": "A_014", "from": "N_MECH_TLAK",  "to": "N_EXTRASYSTOLY", "condition": "user.symptoms.includes('EXTRASYSTOLY') || user.symptoms.includes('BUSENI_SRDCE')" },

    { "id": "A_015", "from": "N_DEKONDICE",  "to": "N_ZATEZ",        "condition": "user.checkin.movement_level == 'low' || user.checkin.energy < 3" },
    { "id": "A_016", "from": "N_ZTUHE_CEVY", "to": "N_ZATEZ",        "condition": "user.labs.systolic_bp > 150" },
    { "id": "A_017", "from": "N_ZATEZ",      "to": "N_EXTRASYSTOLY", "condition": "user.symptoms.includes('EXTRASYSTOLY') || user.checkin.energy < 2" },

    { "id": "A_018", "from": "N_STRES",      "to": "N_SYMPATIKUS",   "condition": "user.checkin.stress > 3 || user.diagnoses.includes('CHRONICKY_STRES')" },
    { "id": "A_019", "from": "N_SPANEK",     "to": "N_SYMPATIKUS",   "condition": "user.checkin.sleep_hours < 6.5" },
    { "id": "A_020", "from": "N_SPANEK",     "to": "N_DEKONDICE",    "condition": "user.checkin.sleep_hours < 6.0 && user.checkin.movement_level == 'low'" },
    { "id": "A_021", "from": "N_SYMPATIKUS", "to": "N_VYSOKY_TK",    "condition": "user.checkin.stress > 3 && user.labs.systolic_bp > 130" },
    { "id": "A_022", "from": "N_SYMPATIKUS", "to": "N_NAPETI_ANS",   "condition": "user.checkin.stress > 3 || user.diagnoses.includes('CHRONICKY_STRES')" },
    { "id": "A_023", "from": "N_SYMPATIKUS", "to": "N_HYPOKALEMIE",  "condition": "user.checkin.stress > 4 && user.labs.k < 3.8" },
    { "id": "A_024", "from": "N_NAPETI_ANS", "to": "N_NIZKE_HRV",    "condition": "user.checkin.hrv < 30 || user.checkin.stress > 3 || user.diagnoses.includes('CHRONICKY_STRES')" },
    { "id": "A_025", "from": "N_NAPETI_ANS", "to": "N_DRAZDIVOST",   "condition": "user.checkin.stress > 3 || user.diagnoses.includes('FIBRILACE_SINI_PAROXYSMALNI')" },
    { "id": "A_026", "from": "N_NIZKE_HRV",  "to": "N_DRAZDIVOST",   "condition": "user.checkin.hrv < 25 || user.diagnoses.includes('FIBRILACE_SINI_PAROXYSMALNI')" },
    { "id": "A_027", "from": "N_HYPOKALEMIE","to": "N_DRAZDIVOST",   "condition": "user.labs.k < 3.5" },
    { "id": "A_028", "from": "N_ZANET",      "to": "N_DRAZDIVOST",   "condition": "user.labs.crp > 2.0 && user.diagnoses.includes('FIBRILACE_SINI_PAROXYSMALNI')" },

    { "id": "A_029", "from": "N_DRAZDIVOST", "to": "N_EXTRASYSTOLY", "condition": "user.symptoms.includes('EXTRASYSTOLY') || user.diagnoses.includes('EXTRASYSTOLY')" },
    { "id": "A_030", "from": "N_EXTRASYSTOLY","to": "N_FAP",         "condition": "user.diagnoses.includes('FIBRILACE_SINI_PAROXYSMALNI') || user.diagnoses.includes('FIBRILACE_SINI')" },

    { "id": "A_031", "from": "N_DEKONDICE",  "to": "N_STRES",        "condition": "user.checkin.movement_level == 'low' && user.checkin.stress > 3" },
    { "id": "A_032", "from": "N_STRES",      "to": "N_INSRES",       "condition": "user.checkin.stress > 4 && user.labs.glucose > 5.6" },
    { "id": "A_033", "from": "N_STRES",      "to": "N_SPANEK",       "condition": "user.checkin.stress > 3 && user.checkin.sleep_hours < 7.0" },
    { "id": "A_034", "from": "N_NIZKE_HRV",  "to": "N_ZATEZ",        "condition": "user.checkin.hrv < 25 && user.checkin.energy < 3" }
  ],

  "medication_shields": [
    {
      "med": "Torvacard",
      "inn": "Atorvastatin",
      "group": "statin",
      "shields_arrow": "A_006",
      "reason": "Blokuje tvorbu LDL v játrech — brání usazování plaků v cévách u samotného zdroje"
    },
    {
      "med": "Kalnormin",
