      "group": "elektrolyt",
      "shields_arrow": "A_027",
      "reason": "Doplňuje draslík — stabilizuje elektrický potenciál buněk síní a brání vzniku dráždivosti"
    },
    {
      "med": "Pradaxa",
      "inn": "Dabigatran",
      "group": "antikoagulans",
      "shields_node": "N_FAP",
      "reason": "Nechrání před fibrilací, ale blokuje její fatální důsledek — srážení krve v síních a riziko mrtvice"
    }
  ]
}
