    { "id": "A_029", "from": "N_DRAZDIVOST", "to": "N_EXTRASYSTOLY", "condition": "user.symptoms.includes('EXTRASYSTOLY') || user.diagnoses.includes('EXTRASYSTOLY')" },
    { "id": "A_030", "from": "N_EXTRASYSTOLY","to": "N_FAP",         "condition": "user.diagnoses.includes('FIBRILACE_SINI_PAROXYSMALNI') || user.diagnoses.includes('FIBRILACE_SINI')" },

