{
    "buildCommand": "",
    "outputDirectory": ".",
    "framework": null,
    "headers": [
        {
            "source": "/(.*\\.html)",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, s-maxage=0" },
                { "key": "Pragma", "value": "no-cache" },
                { "key": "Surrogate-Control", "value": "no-store" },
                { "key": "CDN-Cache-Control", "value": "no-store" }
            ]
        },
        {
            "source": "/app(/?)",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, s-maxage=0" },
                { "key": "Pragma", "value": "no-cache" },
                { "key": "Surrogate-Control", "value": "no-store" },
                { "key": "CDN-Cache-Control", "value": "no-store" }
            ]
        },
        {
            "source": "/hud",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, s-maxage=0" },
                { "key": "Pragma", "value": "no-cache" },
                { "key": "Surrogate-Control", "value": "no-store" },
                { "key": "CDN-Cache-Control", "value": "no-store" }
            ]
        },
        {
            "source": "/",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, s-maxage=0" },
                { "key": "Pragma", "value": "no-cache" },
                { "key": "Surrogate-Control", "value": "no-store" },
                { "key": "CDN-Cache-Control", "value": "no-store" }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/hud",
            "destination": "/app/hud.html"
        },
        {
            "source": "/app/hud.html",
            "destination": "/app/hud.html"
        },
        {
            "source": "/app",
            "destination": "/app/app.html"
        },
        {
            "source": "/app/",
            "destination": "/app/app.html"
        },
        {
            "source": "/",
            "destination": "/app/landing.html"
        },
        {
            "source": "/(.*)",
            "destination": "/app/$1"
        }
    ]
}
