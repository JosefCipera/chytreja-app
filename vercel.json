{
    "buildCommand": "",
    "outputDirectory": ".",
    "framework": null,
    "headers": [
        {
            "source": "/(.*\\.html)",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
                { "key": "Pragma", "value": "no-cache" }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/hud",
            "destination": "/app/hud.html"
        },
        {
            "source": "/app/hud.html",
            "destination": "/app/hud.html"
        },
        {
            "source": "/app",
            "destination": "/app/app.html"
        },
        {
            "source": "/app/",
            "destination": "/app/app.html"
        },
        {
            "source": "/",
            "destination": "/app/landing.html"
        },
        {
            "source": "/(.*)",
            "destination": "/app/$1"
        }
    ]
}
