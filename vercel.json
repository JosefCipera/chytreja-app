{
    "buildCommand": "",
    "outputDirectory": ".",
    "framework": null,
    "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"${DEPLOY_BRANCH:-main}\" ]",
    "functions": {
        "api/tools/parse.js":          { "maxDuration": 60 },
        "api/hud-data-bulk.js":        { "includeFiles": "data/crt/**" },
        "api/crt-generate.js":         { "includeFiles": "data/crt/**", "maxDuration": 120 },
        "api/engine-v1.js":            { "includeFiles": "data/engine/**", "maxDuration": 30 }
    },
    "headers": [
        {
            "source": "/ukazka/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate, s-maxage=0"
                }
            ]
        },
        {
            "source": "/(.*\\.html)",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, s-maxage=0" },
                { "key": "Pragma", "value": "no-cache" },
                { "key": "Surrogate-Control", "value": "no-store" },
                { "key": "CDN-Cache-Control", "value": "no-store" }
            ]
        },
        {
            "source": "/app(/?)",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, s-maxage=0" },
                { "key": "Pragma", "value": "no-cache" },
                { "key": "Surrogate-Control", "value": "no-store" },
                { "key": "CDN-Cache-Control", "value": "no-store" }
            ]
        },
        {
            "source": "/service-worker.js",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
                { "key": "Pragma", "value": "no-cache" }
            ]
        },
        {
            "source": "/app/js/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
                { "key": "Pragma", "value": "no-cache" },
                { "key": "Surrogate-Control", "value": "no-store" },
                { "key": "CDN-Cache-Control", "value": "no-store" }
            ]
        },
        {
            "source": "/app/css/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
                { "key": "Pragma", "value": "no-cache" },
                { "key": "Surrogate-Control", "value": "no-store" },
                { "key": "CDN-Cache-Control", "value": "no-store" }
            ]
        },
        {
            "source": "/data/(.*\\.json)",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
                { "key": "Pragma", "value": "no-cache" },
                { "key": "CDN-Cache-Control", "value": "no-store" }
            ]
        },
        {
            "source": "/hud",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, s-maxage=0" },
                { "key": "Pragma", "value": "no-cache" },
                { "key": "Surrogate-Control", "value": "no-store" },
                { "key": "CDN-Cache-Control", "value": "no-store" }
            ]
        },
        {
            "source": "/landing",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, s-maxage=0" },
                { "key": "Pragma", "value": "no-cache" },
                { "key": "Surrogate-Control", "value": "no-store" },
                { "key": "CDN-Cache-Control", "value": "no-store" }
            ]
        },
        {
            "source": "/home-v2",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, s-maxage=0" },
                { "key": "Pragma", "value": "no-cache" },
                { "key": "Surrogate-Control", "value": "no-store" },
                { "key": "CDN-Cache-Control", "value": "no-store" }
            ]
        },
        {
            "source": "/zakladatele(/?)",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, s-maxage=0" },
                { "key": "Pragma", "value": "no-cache" },
                { "key": "Surrogate-Control", "value": "no-store" },
                { "key": "CDN-Cache-Control", "value": "no-store" }
            ]
        },
        {
            "source": "/",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, s-maxage=0" },
                { "key": "Pragma", "value": "no-cache" },
                { "key": "Surrogate-Control", "value": "no-store" },
                { "key": "CDN-Cache-Control", "value": "no-store" }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/ukazka/crt",
            "destination": "/app/ukazka.html"
        },
        {
            "source": "/ukazka/crt/",
            "destination": "/app/ukazka.html"
        },
        {
            "source": "/ukazka/vesmir",
            "destination": "/app/ukazka.html"
        },
        {
            "source": "/ukazka/vesmir/",
            "destination": "/app/ukazka.html"
        },
        {
            "source": "/hud",
            "destination": "/app/hud.html"
        },
        {
            "source": "/app/hud.html",
            "destination": "/app/hud.html"
        },
        {
            "source": "/app",
            "destination": "/app/index.html"
        },
        {
            "source": "/app/",
            "destination": "/app/index.html"
        },
        {
            "source": "/",
            "destination": "/app/home-v2.html"
        },
        {
            "source": "/landing",
            "destination": "/app/landing.html"
        },
        {
            "source": "/home-v2",
            "destination": "/app/home-v2.html"
        },
        {
            "source": "/zakladatele",
            "destination": "/app/zakladatele.html"
        },
        {
            "source": "/zakladatele/",
            "destination": "/app/zakladatele.html"
        },
        {
            "source": "/login",
            "destination": "/app/login.html"
        },
        {
            "source": "/launcher",
            "destination": "/app/launcher.html"
        },
        {
            "source": "/obchodni-podminky",
            "destination": "/app/obchodni-podminky.html"
        },
        {
            "source": "/ochrana-osobnich-udaju",
            "destination": "/app/ochrana-osobnich-udaju.html"
        },
        {
            "source": "/cookies",
            "destination": "/app/cookies.html"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/app/$1"
        }
    ]
}
