{
    "buildCommand": "",
    "outputDirectory": ".",
    "framework": null,
    "alias": ["dev.iting.cz"],
    "functions": {
        "api/orchestrator.js":         { "maxDuration": 60 },
        "api/tools/parse.js":          { "maxDuration": 60 }
    },
    "headers": [
        {
            "source": "/(.*\\.html)",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, s-maxage=0" },
                { "key": "Pragma", "value": "no-cache" },
                { "key": "Surrogate-Control", "value": "no-store" },
                { "key": "CDN-Cache-Control", "value": "no-store" }
            ]
        },
        {
            "source": "/app(/?)",
            "headers": [
                { "key": "Cache-Control", "value": "private, no-cache, no-store, must-revalidate, max-age=0" },
                { "key": "Pragma", "value": "no-cache" },
                { "key": "Surrogate-Control", "value": "no-store" },
                { "key": "CDN-Cache-Control", "value": "no-store" }
            ]
        },
        {
            "source": "/service-worker.js",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
                { "key": "Pragma", "value": "no-cache" }
            ]
        },
        {
            "source": "/app/js/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
                { "key": "Pragma", "value": "no-cache" },
                { "key": "Surrogate-Control", "value": "no-store" },
                { "key": "CDN-Cache-Control", "value": "no-store" }
            ]
        },
        {
            "source": "/hud",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, s-maxage=0" },
                { "key": "Pragma", "value": "no-cache" },
                { "key": "Surrogate-Control", "value": "no-store" },
                { "key": "CDN-Cache-Control", "value": "no-store" }
            ]
        },
        {
            "source": "/",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, s-maxage=0" },
                { "key": "Pragma", "value": "no-cache" },
                { "key": "Surrogate-Control", "value": "no-store" },
                { "key": "CDN-Cache-Control", "value": "no-store" }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/hud",
            "destination": "/app/hud.html"
        },
        {
            "source": "/app/hud.html",
            "destination": "/app/hud.html"
        },
        {
            "source": "/app",
            "destination": "/app/index.html"
        },
        {
            "source": "/app/",
            "destination": "/app/index.html"
        },
        {
            "source": "/",
            "destination": "/app/login.html"
        },
        {
            "source": "/login",
            "destination": "/app/login.html"
        },
        {
            "source": "/(.*)",
            "destination": "/app/$1"
        }
    ]
}
